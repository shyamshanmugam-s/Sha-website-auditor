# SHA Website Auditor Environment Configuration

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider Configuration
# Active supported providers: gemini (default), heuristic (offline fallback)
AI_PROVIDER=gemini

# Google Gemini API Key (multimodal vision & synthesis)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Crawler & Audit Limits
MAX_PAGES_DEFAULT=20
MAX_PAGES_LIMIT=50
AUDIT_TIMEOUT_MS=300000
MAX_CONCURRENT_AUDITS=2
MAX_CONCURRENT_PAGE_CRAWLS=3
MAX_RESPONSE_SIZE_BYTES=10485760
